# Server-side key used by /api/ai/* routes.
# Get a free key (no credit card required) at https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# Optional — defaults to llama-3.3-70b-versatile if unset.
# For higher daily throughput at slightly lower quality, try llama-3.1-8b-instant.
GROQ_MODEL=llama-3.3-70b-versatile
